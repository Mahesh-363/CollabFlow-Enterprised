# ========================================================
# CollabFlow Full-Stack Environment Configuration
# ========================================================

# --- Frontend (Vite) ---
VITE_API_URL="http://localhost:8000"
VITE_WS_URL="ws://localhost:8000"

# --- Gemini AI ---
GEMINI_API_KEY=""

# --- Django Backend ---
DJANGO_SETTINGS_MODULE="config.settings.dev"
SECRET_KEY="collabflow-super-secret-key-production-grade-2026"
DEBUG="True"
ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0"

# --- Database & Redis ---
DATABASE_URL="sqlite:///collabflow.sqlite3"
# For production PostgreSQL:
# DATABASE_URL="postgresql://collabflow_admin:CollabFlowSecureDb2026!@localhost:5432/collabflow"

REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"

# --- Security & CORS ---
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- Observability ---
SENTRY_DSN=""
